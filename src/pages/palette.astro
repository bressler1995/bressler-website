---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Star } from 'lucide-react';

const brand = [
	{ hex: '#401F3E', cls: 'bg-brand-plum', role: 'Primary' },
	{ hex: '#3F2E56', cls: 'bg-brand-iris', role: 'Secondary' },
	{ hex: '#759AAB', cls: 'bg-brand-mist', role: 'Low emphasis' },
];

const typeScale = [
	{ cls: 'text-display', use: 'Hero headline. One per page, at most.', face: 'Nunito' },
	{ cls: 'text-h1', use: 'Page title. Default for <h1>.', face: 'Nunito' },
	{ cls: 'text-h2', use: 'Section heading. Default for <h2>.', face: 'Nunito' },
	{ cls: 'text-h3', use: 'Card and list-item titles. Default for <h3>.', face: 'Nunito' },
	{ cls: 'text-h4', use: 'Minor headings. Default for <h4>–<h6>.', face: 'Nunito' },
	{ cls: 'text-body-lg', use: 'Lead paragraphs, hero subheads.', face: 'Open Sans' },
	{ cls: 'text-body', use: 'Default prose. Applied to <p>.', face: 'Open Sans' },
	{ cls: 'text-body-sm', use: 'Card copy, labels, nav links.', face: 'Open Sans' },
	{ cls: 'text-caption', use: 'Metadata, timestamps, overlines.', face: 'Open Sans' },
];

const semantic = [
	'bg-background',
	'bg-card',
	'bg-primary',
	'bg-secondary',
	'bg-muted',
	'bg-accent',
	'bg-border',
	'bg-destructive',
];
---

<BaseLayout title="Design tokens — Brian Ressler">
	<Section align="start">
		<h1 class="text-h1">Design System</h1>
	<p class="text-muted-foreground mt-2">
		Reference for building pages. Toggle the theme in the nav to check both modes.
	</p>

	<Card className="mt-8">
		<CardHeader>
			<CardTitle>Typography</CardTitle>
		</CardHeader>
		<CardContent className="space-y-6">
			<p class="text-muted-foreground text-body-sm">
				Use the semantic step, not a raw Tailwind size — <code>text-h2</code>,
				never <code>text-3xl</code>. Each step carries its own line-height,
				letter-spacing and weight.
				<strong class="text-foreground font-medium">Nunito</strong> is for headings
				and controls (buttons, nav links);
				<strong class="text-foreground font-medium">Open Sans</strong> is for
				everything else. Heading elements get their step automatically, so plain
				markdown is styled without any classes.
			</p>

			<div class="flex flex-col gap-5 border-t pt-4">
				{
					typeScale.map((t) => (
						<div class="flex flex-col gap-1">
							<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
								<code class="text-muted-foreground shrink-0 font-mono text-caption">
									{t.cls}
								</code>
								<span class="text-muted-foreground shrink-0 font-mono text-caption">
									{t.face}
								</span>
							</div>
							<p class={`${t.cls} ${t.face === 'Nunito' ? 'font-heading' : ''}`}>
								The quick brown fox
							</p>
							<p class="text-muted-foreground text-caption">{t.use}</p>
						</div>
					))
				}
			</div>
		</CardContent>
	</Card>

	<Card className="mt-6">
		<CardHeader>
			<CardTitle>Brand palette</CardTitle>
		</CardHeader>
		<CardContent className="space-y-6">
			<div class="grid gap-4 sm:grid-cols-3">
				{
					brand.map((c) => (
						<div>
							<div class={`${c.cls} h-16 rounded-lg border`} />
							<p class="mt-2 text-body-sm font-medium">{c.role}</p>
							<p class="text-muted-foreground font-mono text-caption">{c.hex}</p>
						</div>
					))
				}
			</div>

			<div>
				<p class="mb-2 text-body-sm font-medium">Semantic tokens</p>
				<div class="flex flex-wrap gap-2">
					{
						semantic.map((cls) => (
							<div class="text-center">
								<div class={`${cls} size-12 rounded-md border`} />
								<p class="text-muted-foreground mt-1 font-mono text-caption">
									{cls.replace('bg-', '')}
								</p>
							</div>
						))
					}
				</div>
			</div>

			<div class="space-y-3 border-t pt-4">
				<p class="text-body-sm font-medium">Button variants</p>
				<p class="text-muted-foreground text-caption">
					Primary and secondary are the standard pair for calls to action.
				</p>
				<div class="flex flex-wrap items-center gap-3">
					<Button>Primary</Button>
					<Button variant="secondary">Secondary</Button>
					<Button variant="outline">Outline</Button>
					<Button variant="ghost">Ghost</Button>
					<Button variant="destructive">Destructive</Button>
					<Button variant="link">Link</Button>
				</div>
			</div>

			<div class="space-y-3 border-t pt-4">
				<p class="text-body-sm font-medium">Button sizes</p>
				<p class="text-muted-foreground text-caption">
					<strong class="text-foreground font-medium">default</strong> (h-10) and
					<strong class="text-foreground font-medium">lg</strong> (h-12) are the
					standard sizes. <code>xs</code> and <code>sm</code> are compact variants
					for dense UI like the nav bar — don't use them as page-level actions.
				</p>
				<div class="flex flex-wrap items-end gap-3">
					{
						(['xs', 'sm', 'default', 'lg'] as const).map((size) => (
							<div class="flex flex-col items-center gap-1.5">
								<Button size={size}>{size}</Button>
								<span class="text-muted-foreground font-mono text-caption">
									{size}
								</span>
							</div>
						))
					}
				</div>
				<div class="flex flex-wrap items-end gap-3">
					{
						(['icon-xs', 'icon-sm', 'icon', 'icon-lg'] as const).map((size) => (
							<div class="flex flex-col items-center gap-1.5">
								<Button size={size} variant="secondary" aria-label={size}>
									<Star />
								</Button>
								<span class="text-muted-foreground font-mono text-caption">
									{size}
								</span>
							</div>
						))
					}
				</div>
			</div>

			<div class="space-y-3 border-t pt-4">
				<p class="text-body-sm font-medium">Badges</p>
				<div class="flex flex-wrap gap-2">
					<Badge>Default</Badge>
					<Badge variant="secondary">Secondary</Badge>
					<Badge variant="outline">Outline</Badge>
					<Badge variant="destructive">Destructive</Badge>
				</div>
			</div>
			</CardContent>
		</Card>
	</Section>
</BaseLayout>
