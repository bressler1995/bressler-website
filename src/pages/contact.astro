---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
---

<BaseLayout title="Contact — Brian Ressler">
	<Section align="start">
		<h1 class="text-h1 title-rule">Contact</h1>
	<p class="text-muted-foreground mt-2">
		Placeholder form — not wired to a backend, so it does nothing on submit.
	</p>

	<Card className="mt-8 max-w-lg">
		<CardHeader>
			<CardTitle>Get in touch</CardTitle>
		</CardHeader>
		<CardContent>
			<form class="flex flex-col gap-4">
				<div class="flex flex-col gap-2">
					<label for="name" class="text-label">Name</label>
					<Input id="name" name="name" placeholder="Your name" />
				</div>
				<div class="flex flex-col gap-2">
					<label for="email" class="text-label">Email</label>
					<Input id="email" name="email" type="email" placeholder="you@example.com" />
				</div>
				<div class="flex flex-col gap-2">
					<label for="message" class="text-label">Message</label>
					<Textarea id="message" name="message" rows={5} placeholder="What's up?" />
				</div>
				<Button type="submit" className="w-fit">Send</Button>
			</form>
			</CardContent>
		</Card>
	</Section>
</BaseLayout>
