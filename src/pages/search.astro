---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section';
import SearchResults from '@/components/SearchResults';
import { buildSearchIndex } from '@/lib/search-index';

const searchIndex = await buildSearchIndex();
---

{/* A results list is one long document, not a sequence of full-height scenes —
    snapping would fight scrolling through matches. Same reasoning as
    /design-system. */}
<BaseLayout title="Search — Brian Ressler" snap={false}>
	<Section align="start">
		<h1 class="text-h1 title-rule">Search</h1>
		<p class="text-muted-foreground mt-2">
			Everything on the site — pages, posts and projects.
		</p>

		{/* client:load rather than client:visible: this is above the fold and
		    reads ?q= on mount, so deferring hydration would show an empty box
		    before filling it in. */}
		<SearchResults client:load index={searchIndex} />
	</Section>
</BaseLayout>
