---
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/Nav';
import '@/styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/**
	 * Section-by-section snap scrolling. On by default — it's the house style.
	 *
	 * Turn it off for pages that are really one long document rather than a
	 * sequence of full-height scenes (reference pages, long-form articles),
	 * where being pulled between two distant snap points fights the reader.
	 * This is a stopgap: as pages get purpose-built full-height layouts, they
	 * should be able to turn it back on.
	 */
	snap?: boolean;
}

const {
	title = 'Brian Ressler',
	description = 'Portfolio of Brian Ressler — software engineer.',
	snap = true,
} = Astro.props;
---

{/* data-snap drives both the CSS fallback and the JS controller. The router
    swaps root attributes on navigation, so this follows the page correctly
    without any extra wiring. */}
<html lang="en" class="dark" data-snap={snap ? 'true' : 'false'}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		{/* Enables client-side routing: navigation swaps the document in place
		    instead of doing a full browser reload. */}
		<ClientRouter />

		{/* Runs before first paint so the correct theme is applied with no flash.
		    `is:inline` keeps it out of the bundle, which would be deferred. */}
		<script is:inline>
			(() => {
				const apply = () => {
					const theme = localStorage.getItem('theme') ?? 'dark';
					document.documentElement.classList.toggle('dark', theme === 'dark');
				};
				apply();
				if (!window.__themeListenerBound) {
					window.__themeListenerBound = true;

					// The server always renders class="dark", and the router copies
					// root attributes from the incoming document — so a light-mode
					// navigation lands on a dark <html> until something corrects it.
					// Fixing that in astro:after-swap is too late: the page paints
					// dark for a frame first, which showed up as every token flipping
					// to its dark value mid-transition.
					//
					// astro:before-swap hands over the new document *before* it is
					// swapped in, so the class can be set while it is still off-screen
					// and the flash never happens.
					document.addEventListener('astro:before-swap', (event) => {
						const theme = localStorage.getItem('theme') ?? 'dark';
						event.newDocument.documentElement.classList.toggle(
							'dark',
							theme === 'dark'
						);
					});
					// Kept as a safety net for any path that bypasses before-swap.
					document.addEventListener('astro:after-swap', apply);
				}
			})();
		</script>
		{/* Eased section scrolling. astro:page-load fires on first load and after
		    every client-side navigation, and the module re-binds cleanly. */}
		<script>
			import { initScrollSections } from '@/scripts/scroll-sections';
			document.addEventListener('astro:page-load', initScrollSections);
		</script>
	</head>
	<body class="bg-background text-foreground min-h-dvh antialiased">
		{/* transition:persist keeps this exact DOM node (and its React state)
		    across navigations, so the bar never re-mounts or flickers. */}
		<Nav client:load transition:persist />

		{/* No padding or width here — each <Section> owns its own sizing so
		    every section is exactly one viewport tall. */}
		<main>
			<slot />
		</main>

		{/* Also a snap point. Without one it would sit past the final snap
		    position and mandatory snapping would pull the page back off it. */}
		<footer data-section class="border-border/60 snap-start border-t">
			<div
				class="text-muted-foreground max-w-page text-body-sm mx-auto flex flex-col gap-2 px-6 py-8 sm:flex-row sm:items-center sm:justify-between"
			>
				<p>© {new Date().getFullYear()} Brian Ressler</p>
				<a href="/design-system" class="hover:text-foreground transition-colors">
					Design system
				</a>
			</div>
		</footer>
	</body>
</html>
