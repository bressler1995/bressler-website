---
import Section from '@/components/Section.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';

const groups = [
	{
		title: 'Frontend',
		skills: ['TypeScript', 'React', 'Astro', 'Tailwind CSS', 'Vite'],
	},
	{
		title: 'Backend',
		skills: ['Node.js', 'PostgreSQL', 'REST', 'GraphQL', 'Redis'],
	},
	{
		title: 'Tooling',
		skills: ['Git', 'Docker', 'CI/CD', 'Vitest', 'Playwright'],
	},
];
---

<Section id="skills">
	<h2 class="text-3xl font-semibold tracking-tight">Skills</h2>
	<p class="text-muted-foreground mt-2">Placeholder groupings — edit freely.</p>

	<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			groups.map((group) => (
				<Card>
					<CardHeader>
						<CardTitle>{group.title}</CardTitle>
					</CardHeader>
					<CardContent>
						<ul class="flex flex-wrap gap-2">
							{group.skills.map((skill) => (
								<li>
									<Badge variant="secondary">{skill}</Badge>
								</li>
							))}
						</ul>
					</CardContent>
				</Card>
			))
		}
	</div>
</Section>
