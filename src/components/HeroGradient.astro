---
/**
 * Ambient colour wash sitting behind the globe. Pure CSS, no JS, and driven
 * entirely by the --hero-glow-* tokens so it follows the theme.
 *
 * The first glow is anchored near the globe's centre (68% / 50%) so the sphere
 * reads as lit rather than pasted on; the other two anchor the opposite corners
 * to keep the composition from feeling one-sided.
 */
---

<div
	aria-hidden="true"
	class="pointer-events-none absolute inset-0"
	style="background:
		radial-gradient(55% 60% at 70% 42%, var(--hero-glow-1), transparent 70%),
		radial-gradient(48% 55% at 12% 82%, var(--hero-glow-2), transparent 70%),
		radial-gradient(60% 50% at 95% 92%, var(--hero-glow-3), transparent 75%);"
>
</div>
